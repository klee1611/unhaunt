# Auth0 (web app with Token Vault + CIBA grants enabled)
APP_BASE_URL="http://localhost:3000"
AUTH0_SECRET="use [openssl rand -hex 32] to generate a 32 bytes value"
AUTH0_DOMAIN="{yourDomain}"
AUTH0_CLIENT_ID="{yourClientId}"
AUTH0_CLIENT_SECRET="{yourClientSecret}"
# Audience of the Auth0 API used for phone approval (CIBA)
GHOST_API_AUDIENCE="https://ghost-accounts.local/api"

# Local open model (any OpenAI-compatible endpoint works)
MODEL_BASE_URL="http://localhost:11434/v1"
MODEL_NAME="gemma4:e2b-it-qat"

# Ultramarine (Paper Instruments)
PAPERINSTRUMENTS_API_KEY="{yourKey}"
ULTRAMARINE_MODEL="ultramarine-1-flash"
